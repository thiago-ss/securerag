# SecureRAG demo environment (S10, ADR-0011).
# DEMO-ONLY values. NEVER commit a real .env; production secrets come from
# the secret manager. Copy to ops/.env and adjust if needed:
#   cp ops/.env.example ops/.env

# ---- PostgreSQL (pgvector) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-demo-password
SECURERAG_MIGRATION_PASSWORD=migration-demo-password
SECURERAG_API_PASSWORD=api-demo-password
SECURERAG_WORKER_PASSWORD=worker-demo-password
SECURERAG_AUDIT_RETENTION_PASSWORD=audit-retention-demo-password
SECURERAG_PURGE_PASSWORD=purge-demo-password

# ---- Keycloak ----
KEYCLOAK_ADMIN_PASSWORD=admin-demo
KEYCLOAK_DB_PASSWORD=keycloak-demo-password
# Realm users are defined in ops/keycloak-realm.json (pinned user ids):
#   alice / alice-demo-password, carol / carol-demo-password

# ---- MinIO (demo; SSE-S3 via the static demo KMS key — production uses KES) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio-demo-password
# 32-byte base64 key for MINIO_KMS_SECRET_KEY (demo only). Regenerate with:
#   openssl rand -base64 32
MINIO_KMS_SECRET_KEY=minio:RCp1HOlPWwC2mgEk5lP24xcXv2WBy2myaTBpPK8UEw4=

# ---- SecureRAG API / OIDC ----
OIDC_ISSUER=http://localhost:8080/realms/securerag
OIDC_CLIENT_ID=securerag-api
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback
OIDC_JWKS_URI_INTERNAL=http://proxy:80/realms/securerag/protocol/openid-connect/certs
OIDC_TOKEN_ENDPOINT_INTERNAL=http://proxy:80/realms/securerag/protocol/openid-connect/token
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/
OIDC_DISCOVERY_URL=http://proxy:80/realms/securerag/.well-known/openid-configuration
SESSION_COOKIE_SECURE=false

S3_REGION=us-east-1
S3_BUCKET=securerag-objects

# ---- Observability (ADR-0011; attributes carry identifiers/status only) ----
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_OTLP_ENDPOINT=http://collector:4318/v1/traces

# Host ports for the demo MinIO (remap if 9000/9001 are taken)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Host port for the Caddy reverse proxy (console UI)
PROXY_PORT=8080

# Public host:port the browser uses for the console + keycloak realm
PROXY_HOST=localhost:8080

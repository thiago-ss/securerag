# SecureRAG console image (S10 demo stack, ADR-0011).
# Builds the production bundle, then serves it with vite preview (static
# SPA; hash routing needs no server rewrite). The built app talks to the
# same-origin /api base by default (env.ts). Non-root runtime.
FROM node:24.11.0-alpine AS build

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps apps
COPY packages packages

RUN npm ci --no-audit --no-fund
RUN npm run build --workspace @securerag/web

FROM node:24.11.0-alpine

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web ./apps/web
COPY --from=build /app/package.json ./package.json

ENV NODE_ENV=production
USER node

EXPOSE 4173

CMD ["npx", "vite", "preview", "--root", "/app/apps/web", "--host", "0.0.0.0", "--port", "4173"]

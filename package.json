{
  "name": "securerag",
  "private": true,
  "version": "0.2.0",
  "description": "Production-ready multitenant enterprise knowledge platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm run test --workspace @securerag/db",
    "test:db:catalog": "npm run test:catalog --workspace @securerag/db",
    "test:api": "npm run test --workspace @securerag/api",
    "test:security": "npm run test --workspace @securerag/eval && npm run test --workspace @securerag/api && npm run test --workspace @securerag/security",
    "web:dev": "npm run dev --workspace @securerag/web",
    "demo": "docker compose -f ops/compose.yml up --build -d",
    "demo:seed": "tsx ops/seed-demo.ts",
    "benchmark": "npm run bench --workspace @securerag/eval"
  }
}
